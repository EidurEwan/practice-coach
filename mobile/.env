# The Supabase project the app syncs with. Both values are public by design:
# they ship inside every build, and row level security is what protects the
# data. Expo inlines EXPO_PUBLIC_* at bundle time, on web and native alike
# (app.json `extra` is not embedded in a web export).
#
# Override per machine in .env.local, which is not committed — e.g. to point
# at `npx supabase start` (see .env.example).
EXPO_PUBLIC_SUPABASE_URL=https://zlwmxxltwjhxgvtbvkfi.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_u1CDVtjccLi7GtdbxDondg_ucYJKvSR
