# Copy to .env.local and fill in. Without these the app runs entirely offline:
# no sign-in, no sync, and Settings says "No account yet".
#
# From a project at supabase.com: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Running the stack locally instead (`npx supabase start`):
#   Android emulator reaches the host on 10.0.2.2, not localhost or 127.0.0.1
#   iOS simulator and web can use http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<the ANON_KEY printed by `npx supabase status`>
